# ---------------------------------------------------------------
# ARTENREICH Website – Konfiguration (Kopie als .env anlegen)
# ---------------------------------------------------------------

# Indexierung durch Suchmaschinen. Nur für den freigegebenen Livegang auf "true" setzen.
PUBLIC_INDEXING=false

# --- Anfrageformular: E-Mail-Versand über SMTP -------------------
# Ohne diese Angaben nimmt der Server keine Anfragen an und die Website
# bietet ehrlich den Weg «Anfrage per E-Mail» an.
SMTP_HOST=
SMTP_PORT=587
# "true" für Port 465 (implizites TLS), sonst "false" (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absenderadresse, die der SMTP-Server versenden darf
MAIL_FROM=
# Empfänger der Anfragen (z. B. info@artenreich.ch) – erst nach Freigabe eintragen
MAIL_TO=

# Optional: Rate-Limit pro IP (gültige Anfragen pro 10 Minuten)
FORM_RATE_LIMIT=5
# "true", wenn der Node-Server hinter einem Reverse-Proxy läuft (X-Forwarded-For auswerten)
TRUST_PROXY=false

# Node-Server (Astro Node-Adapter)
HOST=0.0.0.0
PORT=4321
