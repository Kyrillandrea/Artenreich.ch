---
/** Startseite, Kapitel 2: «Ein Garten. Unzählige Lebensräume.» */
import Media from './Media.astro';
import Icon from './Icon.astro';
import { philosophy } from '../data/content';
import { url } from '../lib/url';
import BloomHeading from './BloomHeading.astro';
---

<section class="habitat section" id="philosophie" aria-labelledby="habitat-title">
  <div class="container grid-12 habitat__grid">
    <div class="habitat__head">
      <p class="eyebrow habitat__eyebrow">Unsere Haltung</p>
      <BloomHeading
        id="habitat-title"
        lines={[
          [{ text: 'Ein' }, { text: 'Garten.' }],
          [{ text: 'Unzählige', em: true }, { text: 'Lebensräume.' }],
        ]}
      />
    </div>

    <figure class="habitat__main" data-reveal>
      <div class="habitat__move" data-parallax="0.07">
        <div class="frame habitat__frame">
          <Media id="galerie-15" sizes="(min-width: 1100px) 38vw, (min-width: 700px) 50vw, 100vw" />
        </div>
      </div>
    </figure>

    <div class="habitat__text" data-reveal style="--reveal-delay:120ms">
      <p class="lead">{philosophy[0]}</p>
      <p class="habitat__body">{philosophy[2]}</p>
      <a class="text-link" href={url('/naturgarten/')}>
        Mehr über den Naturgarten
        <Icon name="arrow-right" size={18} />
      </a>
    </div>

    <figure class="habitat__detail" data-reveal style="--reveal-delay:200ms">
      <div class="frame habitat__detail-frame">
        <Media id="galerie-14" sizes="(min-width: 1100px) 22vw, 40vw" widths={[360, 540, 720, 960]} />
      </div>
    </figure>
  </div>
</section>

<style>
  .habitat {
    padding-top: clamp(112px, 14vw, 220px);
  }
  .habitat__grid {
    row-gap: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .habitat__head {
    grid-column: 1 / -1;
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-bottom: clamp(16px, 4vw, 64px);
  }
  .habitat__main {
    grid-column: 1 / -1;
  }
  .habitat__frame {
    aspect-ratio: 4 / 5;
  }
  .habitat__text {
    grid-column: 1 / -1;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .habitat__body {
    color: var(--fg-muted);
    max-width: 52ch;
  }
  .habitat__detail {
    grid-column: 5 / -1;
  }
  .habitat__detail-frame {
    aspect-ratio: 1;
  }

  @media (min-width: 700px) {
    .habitat__main {
      grid-column: 1 / span 6;
      grid-row: 2 / span 2;
    }
    .habitat__text {
      grid-column: 7 / -1;
      grid-row: 2;
      padding-top: 8px;
    }
    .habitat__detail {
      grid-column: 9 / -1;
      grid-row: 3;
    }
  }
  @media (min-width: 1100px) {
    .habitat__main {
      grid-column: 1 / span 5;
    }
    .habitat__text {
      grid-column: 7 / span 5;
      padding-top: clamp(16px, 4vw, 64px);
    }
    .habitat__detail {
      grid-column: 9 / span 3;
      margin-top: -24px;
    }
  }
</style>
