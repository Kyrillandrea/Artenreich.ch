---
/**
 * Abstraktes Wasser-Motiv: feine konzentrische Ringlinien mit einer einmaligen,
 * kurzen Wellenbewegung (unter 5 Sekunden), sobald das Motiv sichtbar wird.
 * Rein dekorativ – stellt keine Anlage dar.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const rings = [46, 78, 112, 148, 186, 226, 268];
---

<div class:list={['rings', className]} aria-hidden="true" data-rings>
  <svg viewBox="0 0 600 600" fill="none" focusable="false">
    <defs>
      <radialGradient id="rings-light" cx="42%" cy="40%" r="60%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.16"></stop>
        <stop offset="60%" stop-color="currentColor" stop-opacity="0.03"></stop>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle class="rings__light" cx="300" cy="300" r="290" fill="url(#rings-light)"></circle>
    {
      rings.map((r, i) => (
        <circle
          class="rings__static"
          cx="300"
          cy="300"
          r={r}
          stroke="currentColor"
          stroke-opacity={(0.5 - i * 0.055).toFixed(3)}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
    <g class="rings__waves">
      <circle class="rings__wave" cx="300" cy="300" r="40" stroke="currentColor" vector-effect="non-scaling-stroke"></circle>
      <circle class="rings__wave" cx="300" cy="300" r="40" stroke="currentColor" vector-effect="non-scaling-stroke"></circle>
      <circle class="rings__wave" cx="300" cy="300" r="40" stroke="currentColor" vector-effect="non-scaling-stroke"></circle>
    </g>
  </svg>
</div>

<style>
  .rings {
    color: var(--c-sage);
    width: 100%;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .rings svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .rings__static {
    stroke-width: 1;
  }
  .rings__wave {
    stroke-width: 1.25;
    opacity: 0;
    transform-origin: 300px 300px;
    transform-box: view-box;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rings.is-playing .rings__wave {
      animation: ring-wave 3.2s cubic-bezier(0.16, 0.7, 0.3, 1) both;
    }
    .rings.is-playing .rings__wave:nth-child(2) {
      animation-delay: 0.6s;
    }
    .rings.is-playing .rings__wave:nth-child(3) {
      animation-delay: 1.2s;
    }
    .rings.is-playing .rings__light {
      animation: ring-light 4.4s var(--ease-in-out) both;
    }
    @keyframes ring-wave {
      0% {
        opacity: 0;
        transform: scale(0.6);
      }
      12% {
        opacity: 0.85;
      }
      100% {
        opacity: 0;
        transform: scale(7);
      }
    }
    @keyframes ring-light {
      0% {
        transform: translate(-4%, -3%);
        opacity: 0.6;
      }
      100% {
        transform: translate(0, 0);
        opacity: 1;
      }
    }
  }
</style>

<script>
  const rings = document.querySelectorAll<HTMLElement>('[data-rings]');
  if ('IntersectionObserver' in window && rings.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-playing');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    rings.forEach((el) => io.observe(el));
  }
</script>
