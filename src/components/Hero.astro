---
/**
 * Technik 01 – Layered Parallax.
 * Mehrere Tiefenebenen (Foto hinten, Dunst, Text, zwei Bildfenster vorn) bewegen sich beim
 * Scrollen unterschiedlich schnell; auf Desktop reagieren sie zusätzlich sanft auf die Maus.
 * Ohne Skript bzw. bei reduzierter Bewegung steht das Bild ruhig. Vorbereitet für Originalvideo.
 */
import Media from './Media.astro';
import Icon from './Icon.astro';
import { hero } from '../data/content';
import { getLocalImage, getMediaItem } from '../lib/media';
import { url } from '../lib/url';
import { getImage } from 'astro:assets';
import type { MediaId } from '../data/media';

interface Props {
  back?: MediaId;
  fronts?: MediaId[];
  eyebrow?: string;
  title?: string[];
  subtitle?: string;
  text?: string;
  primary?: { label: string; href: string; projekt?: string };
  secondary?: { label: string; href: string };
  /** Kleinere H1 für Titel mit langen Wörtern */
  compact?: boolean;
}
const {
  back = hero.layers.back,
  fronts = hero.layers.front,
  eyebrow,
  title = hero.title,
  subtitle = hero.subtitle,
  text,
  primary = { label: hero.primary.label, href: '#anfrage', projekt: hero.primary.projekt },
  secondary = hero.secondary,
  compact = false,
} = Astro.props;

const video = hero.video;
let poster: string | undefined;
if (video) {
  const local = getLocalImage(video.poster);
  poster = local ? (await getImage({ src: local, width: 1920, format: 'webp' })).src : getMediaItem(video.poster).src;
}
const [frontA, frontB] = fronts;
---

<section class="hero" data-intro data-layered aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media">
      <div class="hero__layer hero__back" data-depth="0.42" data-mouse="12">
        <Media id={back} sizes="100vw" widths={[640, 960, 1320]} priority />
        {
          video && (
            <video class="hero__video" muted playsinline loop preload="none" poster={poster} aria-hidden="true" data-hero-video>
              {video.sources.map((s) => (
                <source src={s.src} type={s.type} media={s.media} />
              ))}
            </video>
          )
        }
      </div>
      <div class="hero__layer hero__haze" data-depth="0.26" data-mouse="22" aria-hidden="true"></div>
      <div class="hero__shade" aria-hidden="true"></div>
    </div>

    <div class="hero__content container" data-depth="0.14" data-fade>
      {eyebrow && <p class="eyebrow hero__eyebrow">{eyebrow}</p>}
      <h1 id="hero-title" class:list={['display', 'hero__title', { 'hero__title--compact': compact }]}>
        {title.map((line) => <span class="hero__line">{line}</span>)}
      </h1>
      <p class="hero__subtitle">{subtitle}</p>
      {text && <p class="hero__text">{text}</p>}
      <div class="hero__actions">
        <a class="btn btn--light" href={url(primary.href)} data-projekt={primary.projekt}>
          {primary.label}
          <Icon name="arrow-right" />
        </a>
        {secondary && (
          <a class="btn btn--ghost hero__ghost" href={url(secondary.href)}>
            {secondary.label}
          </a>
        )}
      </div>
      {
        video && (
          <button class="hero__video-toggle" type="button" data-hero-video-toggle hidden>
            Film anhalten
          </button>
        )
      }
    </div>

    {
      frontA && (
        <div class="hero__layer hero__front hero__front--a" data-depth="-0.2" data-mouse="-26" aria-hidden="true">
          <div class="hero__frame hero__frame--arch">
            <Media id={frontA} sizes="(min-width: 1100px) 22vw, 30vw" widths={[360, 540, 760]} alt="" loading="eager" />
          </div>
        </div>
      )
    }
    {
      frontB && (
        <div class="hero__layer hero__front hero__front--b" data-depth="-0.38" data-mouse="-40" aria-hidden="true">
          <div class="hero__frame hero__frame--round">
            <Media id={frontB} sizes="(min-width: 1100px) 13vw, 18vw" widths={[240, 360, 480]} alt="" loading="eager" />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--c-offwhite);
  }
  .hero__stage {
    position: relative;
    min-height: max(560px, calc(100svh - var(--header-h)));
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--c-pine);
    z-index: -1;
  }
  .hero__layer {
    --sy: 0px;
    --mx: 0px;
    --my: 0px;
    transform: translate3d(var(--mx), calc(var(--sy) + var(--my)), 0);
  }
  .hero__back {
    position: absolute;
    inset: -4%;
  }
  .hero__back :global(.media),
  .hero__back :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Dunstschicht über dem Horizont – wie Nebel zwischen den Ebenen */
  .hero__haze {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 18%;
    height: 46%;
    background:
      radial-gradient(60% 50% at 30% 55%, rgba(244, 241, 233, 0.22), transparent 70%),
      radial-gradient(45% 40% at 78% 45%, rgba(244, 241, 233, 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(20, 43, 35, 0.84) 0%, rgba(20, 43, 35, 0.5) 32%, rgba(20, 43, 35, 0.06) 66%, rgba(20, 43, 35, 0) 100%),
      linear-gradient(to right, rgba(20, 43, 35, 0.42) 0%, rgba(20, 43, 35, 0) 60%);
  }

  .hero__content {
    position: relative;
    z-index: 4;
    padding-block: clamp(96px, 16vh, 200px) clamp(40px, 7vh, 88px);
    color: var(--c-on-dark);
    --focus: var(--c-on-dark);
    transform: translate3d(0, var(--sy, 0px), 0);
    opacity: var(--fade, 1);
  }
  .hero__title {
    font-weight: 600;
    text-shadow: 0 1px 24px rgba(20, 43, 35, 0.35);
  }
  .hero__line {
    display: block;
  }
  .hero__title--compact {
    font-size: clamp(2.5rem, 6.2vw + 1.2rem, 7.5rem);
  }
  .hero__subtitle {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 34ch;
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.375rem);
    font-weight: 450;
    line-height: 1.5;
    color: #f8f5ee;
    text-shadow: 0 1px 14px rgba(20, 43, 35, 0.45);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: clamp(28px, 3vw, 44px);
  }
  .hero__ghost {
    color: var(--c-on-dark);
  }
  .hero__eyebrow {
    margin-bottom: 20px;
    color: var(--c-sage);
  }
  .hero__text {
    margin-top: 16px;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #f1eee6;
    text-shadow: 0 1px 12px rgba(20, 43, 35, 0.5);
  }
  .hero__video-toggle {
    margin-top: 20px;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    background: rgba(20, 43, 35, 0.4);
    color: inherit;
    font-size: var(--fs-small);
  }

  /* Vordere Ebenen */
  .hero__front {
    display: none;
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    background: var(--c-pine-2);
    box-shadow: 0 34px 70px -34px rgba(10, 24, 19, 0.75);
  }
  .hero__frame :global(.media),
  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__frame--arch {
    aspect-ratio: 3 / 4;
    border-radius: 50% 50% var(--radius) var(--radius) / 34% 34% var(--radius) var(--radius);
  }
  .hero__frame--round {
    aspect-ratio: 1;
    border-radius: 50%;
    outline: 1px solid rgba(244, 241, 233, 0.5);
    outline-offset: 8px;
  }
  @media (min-width: 900px) {
    .hero:has(.hero__front) .hero__content {
      padding-right: 30vw;
    }
    .hero__front {
      display: block;
      position: absolute;
      z-index: 3;
    }
    .hero__front--a {
      right: var(--gutter);
      bottom: clamp(-180px, -10.5vw, -72px);
      width: clamp(220px, 21vw, 340px);
    }
    .hero__front--b {
      right: calc(var(--gutter) + clamp(200px, 19vw, 320px));
      top: clamp(48px, 10vh, 120px);
      width: clamp(120px, 11vw, 190px);
    }
  }
  @media (min-width: 1100px) {
    .hero__content,
    .hero:has(.hero__front) .hero__content {
      padding-right: 0;
    }
  }
  @media (max-width: 420px) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__back :global(img) {
      animation: hero-approach 3.2s var(--ease-out) both;
    }
    .hero__line,
    .hero__subtitle,
    .hero__actions {
      animation: hero-rise 1s var(--ease-out) both;
    }
    .hero__line:nth-child(2) {
      animation-delay: 120ms;
    }
    .hero__subtitle {
      animation-delay: 260ms;
    }
    .hero__actions {
      animation-delay: 380ms;
    }
    .hero__frame {
      animation: hero-front 1.6s var(--ease-out) 200ms both;
    }
    .hero__front--b .hero__frame {
      animation-delay: 420ms;
    }
    @keyframes hero-approach {
      from {
        transform: scale(1.08);
      }
      to {
        transform: scale(1);
      }
    }
    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
    @keyframes hero-front {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.96);
      }
    }
  }
</style>

<script>
  import { initLayeredHero } from '../scripts/layered-hero';
  initLayeredHero();

  // Nur aktiv, wenn ein freigegebenes Originalvideo eingetragen ist.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
  if (video && toggle) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!reduced && !saveData) {
      video.preload = 'auto';
      video.play().then(
        () => {
          toggle.hidden = false;
        },
        () => {},
      );
      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          toggle.textContent = 'Film anhalten';
        } else {
          video.pause();
          toggle.textContent = 'Film abspielen';
        }
      });
    }
  }
</script>
