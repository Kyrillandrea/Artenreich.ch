---
/** Startseite, Kapitel 3: hervorgehobener Naturpool-/Schwimmteichbereich mit Anfrageweg */
import WaterRings from './WaterRings.astro';
import Icon from './Icon.astro';
import { poolIntro, poolCta, planningQuestions } from '../data/pool';
---

<section class="water section theme-pine" id="naturpools" aria-labelledby="water-title">
  <div class="water__rings">
    <WaterRings />
  </div>
  <div class="container grid-12 water__grid">
    <div class="water__head" data-reveal>
      <p class="eyebrow">Naturpools &amp; Schwimmteiche</p>
      <h2 id="water-title" class="h2 water__title">Wasser erleben. <span class="water__soft">Im eigenen Garten.</span></h2>
    </div>
    <div class="water__intro" data-reveal style="--reveal-delay:120ms">
      <p class="lead">{poolIntro}</p>
      <div class="water__actions">
        <a class="btn" href="#anfrage" data-projekt={poolCta.projekt}>
          {poolCta.label}
          <Icon name="arrow-right" />
        </a>
        <a class="text-link" href="/naturpools-schwimmteiche/">
          Planung, Pflege und häufige Fragen
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>

    <ol class="water__questions" aria-label="Fragen der Planung">
      {
        planningQuestions.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="water__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="water__q-title">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .water {
    overflow: hidden;
  }
  .water__rings {
    position: absolute;
    width: clamp(520px, 72vw, 1100px);
    right: clamp(-420px, -22vw, -160px);
    top: clamp(-260px, -10vw, -80px);
    opacity: 0.9;
  }
  .water__grid {
    position: relative;
    row-gap: clamp(40px, 5vw, 64px);
  }
  .water__head,
  .water__intro,
  .water__questions {
    grid-column: 1 / -1;
  }
  .water__title {
    margin-top: 20px;
  }
  .water__soft {
    display: block;
    font-style: italic;
    color: var(--c-sage);
  }
  .water__intro {
    display: grid;
    gap: 32px;
    max-width: 40rem;
  }
  .water__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .water__questions {
    list-style: none;
    margin: clamp(24px, 4vw, 64px) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .water__questions li {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 16px;
    row-gap: 8px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }
  .water__num {
    grid-row: 1 / span 2;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--c-sage);
  }
  .water__q-title {
    font-size: 1.625rem;
    line-height: 1.15;
  }
  .water__questions p {
    color: var(--fg-muted);
    max-width: 44ch;
  }

  @media (min-width: 900px) {
    .water__head {
      grid-column: 1 / span 7;
    }
    .water__intro {
      grid-column: 1 / span 7;
    }
    .water__questions {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 0;
      column-gap: var(--col-gap);
    }
    .water__questions li {
      grid-template-columns: 1fr;
      align-content: start;
      padding-block: 28px 0;
      border-bottom: 0;
      border-top: 1px solid var(--line);
    }
    .water__num {
      grid-row: auto;
      margin-bottom: 20px;
    }
  }
  @media (min-width: 1100px) {
    .water__head {
      grid-column: 1 / span 6;
    }
    .water__intro {
      grid-column: 1 / span 6;
    }
  }
</style>
