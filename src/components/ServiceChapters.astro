---
/** Gestaltung, Verwirklichung, Betreuung (Originaltexte und -bilder) als gestapelte Karten */
import StackCards from './StackCards.astro';
import { services } from '../data/content';

interface Props {
  title?: string;
  id?: string;
  /** Link zur Detailseite unter jedem Kapitel */
  linkToDetail?: boolean;
}

const { title = 'Von der Idee zum lebendigen Garten.', id = 'leistungen', linkToDetail = false } = Astro.props;
const items = services.map((service) => ({
  id: service.id,
  title: service.title,
  text: service.text,
  image: service.image,
  link: linkToDetail ? { label: `${service.title} im Naturgarten`, href: `/naturgarten/#${service.id}` } : undefined,
}));
---

<section class="services section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="services__head" data-reveal>
      <p class="eyebrow">Leistungen</p>
      <h2 id={`${id}-title`} class="h2 services__title">{title}</h2>
    </div>
    <StackCards items={items} tones={['paper', 'sand', 'pine']} />
  </div>
</section>

<style>
  .services__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 88px);
  }
  .services__title {
    max-width: 13ch;
  }
</style>
