---
/**
 * «Ein Garten. Vier Jahreszeiten.» – Technik 03: Scroll-driven Rotation («Jahresrad»).
 * Desktop mit Bewegung: Die Bühne bleibt stehen, ein Rad mit den vier Jahreszeiten dreht sich
 * beim Scrollen und holt die nächste Jahreszeit nach vorn.
 * Desktop mit reduzierter Bewegung: beschriftete, tastaturbedienbare Auswahl (ARIA-Tabs).
 * Ohne Skript und auf Mobil: vier ruhige Kapitel untereinander.
 */
import Media from './Media.astro';
import { seasons } from '../data/content';

interface Props {
  id?: string;
}
const { id = 'jahreszeiten' } = Astro.props;
---

<section class="seasons section theme-sand" id={id} aria-labelledby={`${id}-title`} data-seasons>
  <div class="seasons__pin" data-seasons-pin>
  <div class="container seasons__inner">
    <div class="seasons__head" data-reveal>
      <p class="eyebrow">Im Wandel</p>
      <h2 id={`${id}-title`} class="h2 seasons__title">Ein Garten. <em>Vier</em> Jahreszeiten.</h2>
    </div>

    <div class="seasons__tablist" role="tablist" aria-label="Jahreszeit wählen" data-seasons-tablist hidden>
      {
        seasons.map((season, i) => (
          <button
            class="seasons__tab"
            type="button"
            role="tab"
            id={`${id}-tab-${season.id}`}
            aria-controls={`${id}-panel-${season.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-index={i}
          >
            <span class="seasons__tab-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {season.title}
          </button>
        ))
      }
    </div>

    <div class="seasons__stage" data-seasons-stage>
      {
        seasons.map((season, i) => (
          <article
            class:list={['season', { 'is-active': i === 0 }]}
            id={`${id}-panel-${season.id}`}
            aria-labelledby={`${id}-heading-${season.id}`}
            data-season
          >
            <div class="season__media frame">
              <Media id={season.image} sizes="(min-width: 900px) 58vw, 100vw" />
            </div>
            <div class="season__text">
              <h3 class="h3 season__title" id={`${id}-heading-${season.id}`}>
                {season.title}
              </h3>
              <ul class="season__lines">
                {season.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="wheel" data-wheel aria-hidden="true" hidden>
      <div class="wheel__words">
        {seasons.map((season, i) => <span class:list={['wheel__word', { 'is-active': i === 0 }]}>{season.title}</span>)}
      </div>
      <div class="wheel__dial" data-dial>
        <svg class="wheel__ring" viewBox="-100 -100 200 200" focusable="false">
          <circle r="86" fill="none" stroke="currentColor" stroke-width="0.35" />
          <circle r="97" fill="none" stroke="currentColor" stroke-width="0.2" stroke-dasharray="0.4 2.2" />
          {
            Array.from({ length: 72 }, (_, t) => (
              <line
                x1="0"
                y1={t % 18 === 0 ? -80 : t % 6 === 0 ? -82 : -84}
                x2="0"
                y2="-88.5"
                stroke="currentColor"
                stroke-width={t % 18 === 0 ? 0.6 : 0.3}
                transform={`rotate(${t * 5})`}
              />
            ))
          }
        </svg>
      </div>
      {
        seasons.map((season, i) => (
          <div class="wheel__node" data-node style={`--k:${i}`}>
            <Media id={season.image} sizes="(min-width: 1000px) 28vw, 40vw" widths={[360, 540, 760, 960]} alt="" />
          </div>
        ))
      }
    </div>
  </div>
  </div>
</section>

<style>
  .seasons__head {
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .seasons__title {
    margin-top: 20px;
  }
  .seasons__title em {
    font-style: italic;
    color: var(--c-sage-ink);
  }

  /* Grundzustand: vier Kapitel untereinander */
  .seasons__stage {
    display: grid;
    gap: clamp(48px, 8vw, 80px);
  }
  .season {
    display: grid;
    gap: 20px;
  }
  .season__media {
    aspect-ratio: 4 / 3;
  }
  .season__title {
    font-size: clamp(2.25rem, 3vw + 1rem, 4rem);
  }
  .season__lines {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .season__lines li {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 0.8vw + 1.1rem, 1.875rem);
    line-height: 1.3;
  }
  .season__lines li::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-right: 14px;
    vertical-align: 0.32em;
    background: var(--c-sage-ink);
  }
  @media (min-width: 700px) and (max-width: 899px) {
    .season {
      grid-template-columns: 3fr 2fr;
      align-items: end;
      gap: 28px;
    }
  }

  /* Ausgebaute Bühne (nur mit Skript ab 900 px) */
  .seasons__tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: clamp(28px, 3vw, 44px);
    border-bottom: 1px solid var(--line);
  }
  .seasons__tablist[hidden] {
    display: none;
  }
  .seasons__tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    min-height: 64px;
    padding: 12px clamp(16px, 2.4vw, 40px) 16px 0;
    margin-right: clamp(8px, 1.6vw, 24px);
    border: 0;
    background: none;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.6vw + 1rem, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: #535b55;
    transition: color var(--dur-mid) var(--ease-out);
  }
  .seasons__tab-num {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .seasons__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: clamp(16px, 2.4vw, 40px);
    bottom: -1px;
    height: 2px;
    background: var(--c-pine);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out);
  }
  .seasons__tab:hover {
    color: var(--c-ink);
  }
  .seasons__tab[aria-selected='true'] {
    color: var(--c-pine);
  }
  .seasons__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .seasons.is-tabs .seasons__stage {
    display: grid;
    gap: 0;
  }
  .seasons.is-tabs .season {
    grid-area: 1 / 1;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: end;
    visibility: hidden;
  }
  .seasons.is-tabs .season.is-active,
  .seasons.is-tabs .season.is-leaving {
    visibility: visible;
  }
  .seasons.is-tabs .season.is-active {
    z-index: 2;
  }
  .seasons.is-tabs .season.is-leaving {
    z-index: 1;
  }
  .seasons.is-tabs .season__media {
    aspect-ratio: 16 / 11;
  }
  /* Nur das aktive Kapitel zeigt Text – kein Überlagern beim Wechsel */
  .seasons.is-tabs .season.is-leaving .season__text {
    visibility: hidden;
  }
  .seasons.is-tabs .season__text {
    padding-bottom: 12px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .seasons.is-tabs .season.is-entering .season__media {
      animation: season-reveal 820ms cubic-bezier(0.6, 0.05, 0.25, 1) both;
    }
    .seasons.is-tabs .season.is-entering .season__media :global(img) {
      animation: season-settle 1100ms var(--ease-out) both;
    }
    .seasons.is-tabs .season.is-entering .season__text {
      animation: season-text 420ms ease both;
    }
    @keyframes season-reveal {
      from {
        clip-path: circle(0% at var(--origin-x, 20%) 70%);
      }
      to {
        clip-path: circle(150% at var(--origin-x, 20%) 70%);
      }
    }
    @keyframes season-settle {
      from {
        transform: scale(1.06);
      }
      to {
        transform: scale(1);
      }
    }
    @keyframes season-text {
      from {
        opacity: 0;
      }
    }
  }
</style>

<style>
  /* ---------- Jahresrad (nur Desktop mit Bewegung, per Skript aktiviert) ---------- */
  .wheel[hidden] {
    display: none;
  }
  .seasons.is-wheel {
    height: calc(100vh + 240vh);
    padding-block: 0;
  }
  .seasons.is-wheel .seasons__pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow: hidden;
  }
  .seasons.is-wheel .seasons__inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto 1fr auto;
    column-gap: var(--col-gap);
    padding-block: clamp(28px, 6vh, 64px);
  }
  .seasons.is-wheel .seasons__head {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    position: relative;
    z-index: 2;
  }
  .seasons.is-wheel .seasons__title {
    font-size: clamp(2.5rem, 3.4vw + 0.6rem, 4.75rem);
  }
  .seasons.is-wheel .seasons__stage {
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    display: grid;
    position: relative;
    z-index: 2;
  }
  .seasons.is-wheel .season {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 280ms ease, transform 280ms ease, visibility 0s linear 280ms;
  }
  .seasons.is-wheel .season.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 480ms var(--ease-out) 80ms, transform 480ms var(--ease-out) 80ms;
  }
  .seasons.is-wheel .season__media {
    display: none;
  }
  .seasons.is-wheel .season__title {
    font-size: clamp(3rem, 4vw + 1rem, 6rem);
  }
  .seasons.is-wheel .seasons__tablist {
    grid-column: 1;
    grid-row: 3;
    margin: 0;
    position: relative;
    z-index: 2;
  }
  .seasons.is-wheel .seasons__tablist {
    flex-wrap: nowrap;
  }
  .seasons.is-wheel .seasons__tab {
    font-size: clamp(1.0625rem, 0.7vw + 0.7rem, 1.5rem);
    min-height: 52px;
    gap: 8px;
    padding-right: clamp(10px, 1vw, 16px);
    margin-right: 2px;
  }
  .seasons.is-wheel .seasons__tab::after {
    right: clamp(10px, 1vw, 16px);
  }
  .seasons.is-wheel .wheel {
    grid-column: 2;
    grid-row: 1 / -1;
    position: relative;
    display: block;
    color: var(--c-pine);
  }
  .wheel__words {
    position: absolute;
    inset: 0 calc(var(--gutter) * -1) 0 -40%;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .wheel__word {
    grid-area: 1 / 1;
    font-family: var(--font-serif);
    font-size: clamp(7rem, 17vw, 18rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-stone);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 500ms ease, transform 700ms var(--ease-out);
    white-space: nowrap;
  }
  .wheel__word.is-active {
    opacity: 0.55;
    transform: none;
  }
  .wheel__dial {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--d, 600px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
  }
  .wheel__ring {
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0.55;
  }
  .wheel__node {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--node, 260px);
    aspect-ratio: 1;
    margin: calc(var(--node, 260px) / -2) 0 0 calc(var(--node, 260px) / -2);
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-stone-2);
    box-shadow: 0 30px 60px -34px rgba(20, 43, 35, 0.6);
    transform: translate3d(var(--x, 0px), var(--y, 0px), 0) scale(var(--ns, 1));
    opacity: var(--o, 1);
    z-index: var(--z, 1);
  }
  .wheel__node :global(.media),
  .wheel__node :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { initSeasons } from '../scripts/seasons';
  initSeasons();
</script>
