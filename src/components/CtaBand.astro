---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  href: string;
  label: string;
  projekt?: string;
  external?: boolean;
  theme?: 'pine' | 'sand';
}
const { title = 'Was darf bei Ihnen wachsen?', href, label, projekt, external = false, theme = 'pine' } = Astro.props;
---

<section class:list={['band section', theme === 'pine' ? 'theme-pine' : 'theme-sand']} aria-labelledby="band-title">
  <div class="container band__inner" data-reveal>
    <h2 id="band-title" class="h2 band__title">{title}</h2>
    <div class="band__actions">
      <slot />
      <a class="btn" href={href} data-projekt={projekt} rel={external ? 'noopener' : undefined}>
        {label}
        <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
        {external && <span class="sr-only">(externe Website)</span>}
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(80px, 10vw, 152px);
  }
  .band__inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }
  .band__title {
    max-width: 14ch;
  }
  .band__actions {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .band__actions :global(p) {
    max-width: 40ch;
    color: var(--fg-muted);
  }
  @media (min-width: 900px) {
    .band__inner {
      grid-template-columns: 7fr 5fr;
      gap: var(--col-gap);
    }
  }
</style>
