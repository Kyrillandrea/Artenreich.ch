---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import StackCards from '../../components/StackCards.astro';
import Media from '../../components/Media.astro';
import Faq from '../../components/Faq.astro';
import InquirySection from '../../components/InquirySection.astro';
import { poolIntro, poolCta, planningQuestions, poolFaq, poolMedia } from '../../data/pool';
import { services } from '../../data/content';
import type { MediaId } from '../../data/media';

const care = services.find((s) => s.id === 'betreuung')!;
const planningImages: MediaId[] = ['pool-01', 'pool-03', 'pool-02', 'pool-04'];
const planningCards = planningQuestions.map((q, i) => ({ title: q.title, text: q.text, image: planningImages[i] }));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: poolFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Naturpools und Schwimmteiche anfragen"
  description="Naturpool oder Schwimmteich im eigenen Garten? Planungsfragen, Pflege und häufige Fragen – und der direkte Weg zur Anfrage bei Artenreich."
  ogImage="pool-05"
  stickyCta={{ href: '#anfrage', projekt: 'naturpool' }}
  jsonLd={[faqSchema]}
>
  <Hero
    back="pool-05"
    fronts={[]}
    eyebrow="Naturpools & Schwimmteiche"
    title={['Naturpools und', 'Schwimmteiche']}
    subtitle="Wasser erleben. Im eigenen Garten."
    text={poolIntro}
    primary={{ label: poolCta.label, href: '#anfrage', projekt: poolCta.projekt }}
    secondary={{ label: 'Fragen der Planung', href: '#planung' }}
    compact
  />

  {
    poolMedia.length > 0 && (
      <section class="section pool-media" aria-label="Aufnahmen">
        <div class="container pool-media__grid">
          {poolMedia.map((m) => (
            <figure>
              <div class="frame">
                <Media id={m.image} sizes="(min-width: 900px) 50vw, 100vw" />
              </div>
              <figcaption>{m.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="section planning" id="planung" aria-labelledby="planning-title">
    <div class="container">
      <div class="planning__head" data-reveal>
        <p class="eyebrow">Planung</p>
        <h2 id="planning-title" class="h2">Fragen der Planung</h2>
      </div>
      <StackCards items={planningCards} tones={['paper', 'sage', 'sand', 'pine']} />
    </div>
  </section>

  <section class="section theme-sand care" id="pflege" aria-labelledby="care-title">
    <div class="container grid-12 care__grid">
      <div class="care__media frame" data-reveal>
        <Media id={care.image} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div class="care__text" data-reveal style="--reveal-delay:120ms">
        <p class="eyebrow">Pflege</p>
        <h2 id="care-title" class="h2">Pflege und Betreuung</h2>
        <p class="lead">{care.text}</p>
        <p class="muted">{planningQuestions[3].text} Pflegeaufgaben und mögliche Betreuung werden im Rahmen der Planung geklärt.</p>
      </div>
    </div>
  </section>

  <section class="section faq-section" id="fragen" aria-labelledby="faq-title">
    <div class="container grid-12 faq-section__grid">
      <div class="faq-section__head" data-reveal>
        <p class="eyebrow">Häufige Fragen</p>
        <h2 id="faq-title" class="h2">Gut zu wissen</h2>
      </div>
      <div class="faq-section__list" data-reveal>
        <Faq items={poolFaq} id="pool-faq" />
      </div>
    </div>
  </section>

  <InquirySection
    title="Ihr Vorhaben besprechen"
    intro={poolFaq[0].a}
    defaultProjekt="naturpool"
    eyebrow="Anfrage Naturpool"
  />
</BaseLayout>

<style>




  .planning__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 88px);
  }

  .care__grid {
    row-gap: 40px;
    align-items: center;
  }
  .care__media,
  .care__text {
    grid-column: 1 / -1;
  }
  .care__media {
    aspect-ratio: 4 / 3;
  }
  .care__text {
    display: grid;
    gap: 20px;
  }
  .care__text .muted {
    max-width: 46ch;
  }
  @media (min-width: 900px) {
    .care__media {
      grid-column: 1 / span 6;
    }
    .care__text {
      grid-column: 8 / -1;
    }
  }

  .faq-section__grid {
    row-gap: 40px;
  }
  .faq-section__head,
  .faq-section__list {
    grid-column: 1 / -1;
  }
  @media (min-width: 1000px) {
    .faq-section__head {
      grid-column: 1 / span 4;
    }
    .faq-section__list {
      grid-column: 6 / -1;
    }
  }

  .pool-media__grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .pool-media__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
