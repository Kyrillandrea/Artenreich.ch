---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Media from '../../components/Media.astro';
import ServiceChapters from '../../components/ServiceChapters.astro';
import Seasons from '../../components/Seasons.astro';
import CtaBand from '../../components/CtaBand.astro';
import { philosophy, sensoryLine } from '../../data/content';
---

<BaseLayout
  title="Naturgärten – Gestaltung, Verwirklichung und Betreuung"
  description="Naturgärten von Artenreich: mit einheimischen Pflanzen und Materialien geplant, rücksichtsvoll umgesetzt und im Einklang mit den Jahreszeiten gepflegt."
  ogImage="galerie-04"
  stickyCta={{ href: '/kontakt/?projekt=naturgarten#anfrage', projekt: 'naturgarten' }}
>
  <PageIntro eyebrow="Naturgarten" title="Naturgärten" lead="Ein Garten. Unzählige Lebensräume." image="galerie-04" />

  <section class="philo section" id="philosophie" aria-labelledby="philo-title">
    <div class="container grid-12 philo__grid">
      <h2 id="philo-title" class="sr-only">Unsere Haltung zum Naturgarten</h2>

      <p class="philo__p1 lead" data-reveal>{philosophy[0]}</p>

      <figure class="philo__img philo__img--a" data-reveal>
        <div data-parallax="0.08">
          <div class="frame philo__frame-a">
            <Media id="galerie-12" sizes="(min-width: 1100px) 30vw, (min-width: 700px) 42vw, 100vw" widths={[400, 640, 900, 1200]} />
          </div>
        </div>
      </figure>

      <div class="philo__p2 prose" data-reveal style="--reveal-delay:100ms">
        <p>{philosophy[1]}</p>
      </div>

      <p class="philo__quote" aria-hidden="true" data-reveal>{sensoryLine}</p>

      <div class="philo__p34 prose" data-reveal>
        <p>{philosophy[2]}</p>
        <p>{philosophy[3]}</p>
      </div>

      <figure class="philo__img philo__img--b" data-reveal style="--reveal-delay:120ms">
        <div class="frame philo__frame-b">
          <Media id="galerie-13" sizes="(min-width: 1100px) 24vw, (min-width: 700px) 36vw, 60vw" widths={[360, 540, 720, 960]} />
        </div>
      </figure>
    </div>
  </section>

  <ServiceChapters />
  <Seasons />
  <CtaBand href="/kontakt/?projekt=naturgarten#anfrage" projekt="naturgarten" label="Naturgarten anfragen" />
</BaseLayout>

<style>
  .philo__grid {
    row-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .philo__p1,
  .philo__img--a,
  .philo__p2,
  .philo__quote,
  .philo__p34,
  .philo__img--b {
    grid-column: 1 / -1;
  }
  .philo__p1 {
    font-size: clamp(1.625rem, 1.6vw + 1.1rem, 2.75rem);
    line-height: 1.24;
    max-width: 30ch;
  }
  .philo__frame-a {
    aspect-ratio: 4 / 5;
  }
  .philo__frame-b {
    aspect-ratio: 1;
  }
  .philo__p2,
  .philo__p34 {
    max-width: 60ch;
  }
  .philo__quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2rem, 3.4vw + 1rem, 4.75rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    color: var(--c-pine);
    text-wrap: balance;
  }
  .philo__img--b {
    grid-column: 5 / -1;
  }

  @media (min-width: 700px) {
    .philo__p1 {
      grid-column: 1 / span 10;
    }
    .philo__img--a {
      grid-column: 1 / span 5;
      grid-row: 2 / span 2;
    }
    .philo__p2 {
      grid-column: 7 / -1;
      grid-row: 2;
      padding-top: clamp(0px, 4vw, 64px);
    }
    .philo__quote {
      grid-column: 1 / -1;
    }
    .philo__p34 {
      grid-column: 1 / span 6;
    }
    .philo__img--b {
      grid-column: 8 / span 5;
    }
  }
  @media (min-width: 1100px) {
    .philo__img--a {
      grid-column: 1 / span 4;
    }
    .philo__p2 {
      grid-column: 6 / span 6;
    }
    .philo__quote {
      grid-column: 2 / span 10;
    }
    .philo__p34 {
      grid-column: 2 / span 5;
    }
    .philo__img--b {
      grid-column: 9 / span 3;
    }
  }
</style>
